# This is intended to be a sample file. Copy this file and  
# name it bhapi-override.env then set the values for this application to function

# OIDC authority
FLASK_AUTHORITY=""

# Application client ID
FLASK_CLIENT_ID=""

# If using Valkey (provided in this project) as a session backend, 
# uncomment the following two lines
# FLASK_SESSION_TYPE="redis"
# FLASK_SESSION_REDIS_HOST="valkey"

# Set SQLALCHEMY_DATABASE_URI, CLIENT_SECRET, and BHAPI_APPLICATION_MODE in the secrets/bhapi_config.py file.
# A sample file is included in the contrib/ folder of this repository